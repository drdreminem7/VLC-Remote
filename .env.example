VLC_REMOTE_HOST=0.0.0.0
VLC_REMOTE_PORT=8000

VLC_HTTP_BASE_URL=http://127.0.0.1:8080
VLC_HTTP_PASSWORD=replace-me

VLC_REMOTE_ACCESS_TOKEN=
VLC_REMOTE_LOG_LEVEL=INFO
VLC_REMOTE_ALLOWED_HOSTS=localhost,127.0.0.1
VLC_REMOTE_ENABLE_DISCOVERY=true

TMDB_API_TOKEN=

# Optional OpenSubtitles search and download (Mac only; never sent to the phone).
# Create an OpenSubtitles.com account, then use its username and password here.
# The API key identifies this remote application; obtain one through the
# OpenSubtitles developer/API subscription portal, not from VLC or VLSub.
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
OPENSUBTITLES_API_KEY=
